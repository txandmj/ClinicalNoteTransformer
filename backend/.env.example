# Server
ANTHROPIC_API_KEY=
# Anthropic API prompt-prefix caching (cache_control on static blocks — vendor billing optimization).
# Legacy alias: ANTHROPIC_PROMPT_CACHE
ANTHROPIC_API_PROMPT_PREFIX_CACHE=true
# Optional: require clients to send X-API-Key matching this value
CLINICAL_API_KEY=

# Cost control (optional)
# Max ~tokens per ER / H&P / other section (approximated as chars = tokens * 4)
GENERATE_MAX_INPUT_TOKENS_PER_SECTION=1500
# LRU cache of full POST /generate JSON (same inputs → no LLM call). Not the Anthropic prefix cache above.
GENERATE_RESPONSE_CACHE_ENABLED=true
GENERATE_RESPONSE_CACHE_MAX_ENTRIES=256
# 0 = unlimited
GENERATE_RATE_LIMIT_PER_MINUTE=30
